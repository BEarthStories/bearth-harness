{
	"$schema": "https://paniolo.ai/schemas/paniolo.config.v2.json",
	"version": "0.5.64",
	"workspace": {
		"file": "bearth-harness.code-workspace"
	},
	"rules": {
		"paniolo-state-gitignored": "off"
	},
	"wiki": {},
	"qmd": {
		"modelDaemon": "off",
		"hooks": {
			"mode": "search",
			"interleave": true
		},
		"collections": {
			"bearthstories": {},
			"midwifery-wiki": {
				"codeComments": {
					"exclude": ["raw/**"]
				}
			}
		}
	},
	"staleness": {
		"enabled": false,
		"ledgerPath": ".paniolo/staleness",
		"autoMerge": true,
		"agentProfiles": {
			"cursor-auto": {
				"adapter": "cursor",
				"model": "auto"
			},
			"devin-swe-2-high": {
				"adapter": "devin",
				"model": "swe-2-high"
			}
		},
		"roles": {
			"verifier": "cursor-auto",
			"verdictChallenger": "devin-swe-2-high",
			"remediator": "cursor-auto",
			"patchChallenger": "devin-swe-2-high"
		},
		"limits": {
			"maxAllegationsPerPhase": 25,
			"timeoutMs": 120000,
			"maxOutputBytes": 262144,
			"maxRepairAttempts": 1,
			"maxPacketBytes": 49152,
			"maxInvocationsPerAllegation": 8
		},
		"retrieval": {
			"topK": 4,
			"maxImmediate": 50,
			"shadow": {
				"enabled": true,
				"documentPoolSize": 20,
				"sectionTopK": 2,
				"maxEntitiesPerRun": 25
			}
		},
		"surfaces": {
			"wikiPages": {
				"repositories": ["midwifery-wiki"],
				"include": ["wiki/**/*.md"]
			},
			"docs": {
				"repositories": ["bearthstories"],
				"include": ["*.md", "README.md", "CONTRIBUTING.md", "docs/**/*.md"],
				"exclude": ["node_modules/**", "dist/**", "generated/**"]
			},
			"codeComments": {
				"repositories": ["bearthstories"],
				"include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx"],
				"exclude": ["node_modules/**", "dist/**", "generated/**"]
			}
		}
	},
	"repos": {
		"bearthstories": {
			"path": "../bearthstories.com",
			"wiki": {
				"root": "."
			}
		},
		"midwifery-wiki": {
			"path": "../midwifery-wiki",
			"wiki": {
				"root": "wiki"
			}
		}
	},
	"name": "bearth-harness"
}
